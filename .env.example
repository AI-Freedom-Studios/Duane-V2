# Database
DATABASE_URL=postgresql://agentos:agentos_dev@localhost:5432/agentos

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me-to-a-random-secret-at-least-32-chars
JWT_EXPIRES_IN=7d

# Encryption (must be at least 16 chars, used for API key encryption)
ENCRYPTION_KEY=change-me-32-byte-hex-encryption-key

# API
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000

# OAuth - Meta (Facebook/Instagram)
META_CLIENT_ID=
META_CLIENT_SECRET=
META_REDIRECT_URI=http://localhost:4000/integrations/oauth/meta/callback

# OAuth - LinkedIn
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:4000/integrations/oauth/linkedin/callback

# OAuth - YouTube (Google)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:4000/integrations/oauth/youtube/callback

# OAuth - TikTok
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:4000/integrations/oauth/tiktok/callback

# OAuth - X (Twitter)
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:4000/integrations/oauth/x/callback

# S3-compatible storage (e.g., Cloudflare R2)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto
